{
  "manifest_version": 3,
  "name": "ClickUp Margin Report",
  "description": "Private bill rates, cost rates, margin, and budget burn for existing ClickUp time entries.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "ClickUp Margin Report",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["https://app.clickup.com/*"],
  "content_scripts": [
    {
      "matches": ["https://app.clickup.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page-bridge.js"],
      "matches": ["https://app.clickup.com/*"]
    }
  ]
}
